generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipTier {
  INDIVIDUAL
  INSTITUTIONAL
  CORPORATE
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  fullName       String
  email          String         @unique
  githubHandle   String?        @unique
  affiliation    String?
  oflaAgreed     Boolean        @default(false)
  oflaAgreedAt   DateTime?
  tier           MembershipTier @default(INDIVIDUAL)
  /// Corporate is capped, Individual scales based on merged GitHub PRs to the Core protocols.
  votingWeight   Float          @default(1.0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}
