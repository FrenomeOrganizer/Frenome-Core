generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipTier {
  INDIVIDUAL
  INSTITUTIONAL
  CORPORATE
}

enum VerificationLevel {
  NONE
  TIER_1_DIGITAL
  TIER_2_STAKE
  TIER_3_KYC
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  fullName          String
  email             String            @unique
  emailVerified     DateTime?
  image             String?
  githubHandle      String?           @unique
  affiliation       String?
  oflaAgreed        Boolean           @default(false)
  oflaAgreedAt      DateTime?
  tier              MembershipTier    @default(INDIVIDUAL)
  verificationLevel VerificationLevel @default(NONE)
  /// Corporate is capped, Individual scales based on merged GitHub PRs to the Core protocols.
  /// Only users with TIER_1_DIGITAL or higher are factored into the consensus.
  votingWeight      Float             @default(1.0)
  accounts          Account[]
  sessions          Session[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
